# ============================================================================
# INR MLA CRM — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- App ---
APP_NAME=INR MLA CRM
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
CAPTCHA_SECRET_KEY=change-me-to-a-different-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_ENCRYPTION_KEY=change-me-fernet-key

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CAPTCHA_TOKEN_EXPIRE_MINUTES=5

# --- Database ---
# Local/Docker Postgres:
DATABASE_URL=postgresql+asyncpg://inr_user:inr_password@localhost:5432/inr_mla_crm
POSTGRES_USER=inr_user
POSTGRES_PASSWORD=inr_password
POSTGRES_DB=inr_mla_crm
# For Render + Neon, set DATABASE_URL to the Neon connection string instead,
# e.g. postgresql+asyncpg://user:pass@ep-xxxx.neon.tech/inr_mla_crm?ssl=require

# --- CORS ---
CORS_ORIGINS=https://mlainr.com,https://mla-inr.netlify.app,http://localhost:3000

# --- File storage ---
# STORAGE_BACKEND=local is the only implementation for now; the interface in
# app/core/storage.py is designed to be swapped for an s3 backend later.
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=/uploads
MAX_UPLOAD_SIZE_MB=25
